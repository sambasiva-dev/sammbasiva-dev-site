---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<SiteLayout title={`${site.brand} — ${site.role}`} currentPath="/">
  <section class="hero section section-muted">
    <div class="hero-copy">
      <div class="profile-intro">
        <div class="profile-photo-wrap"><img class="profile-photo" src="/images/profile.jpg" alt="Portrait photo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" /><div class="profile-photo-fallback" aria-hidden="true">YN</div></div>
        <div><p class="profile-label">HELLO, I'M</p><p class="profile-name">Sambasiva Reddy</p><p class="profile-role">Technology Leader · Software Architect</p></div>
      </div>
      <!--<p class="eyebrow"><span class="status-dot"></span> SOFTWARE ARCHITECTURE · ENGINEERING · AI</p>-->
      <div class="tagline">
        <span class="animated-words">
          <span>I <b>design</b> for change</span>
          <span>I <b>build</b> for scale</span>
          <span>I <b>learn and mentor</b> continuously</span>
          <span>I <b>share</b> what works</span>
        </span>
      </div>
      <p class="hero-description">{site.intro}</p>
      <nav class="social-links" aria-label="Social links">
        <a href={`mailto:${site.email}`} aria-label="Email">
          <svg viewBox="0 0 24 24" class="w-5 h-5" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </a>
        <a href={site.github}
           target="_blank" rel="noopener noreferrer"
           aria-label="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="3 3 18 18"><path d="M12 3C7.0275 3 3 7.12937 3 12.2276c0 4.0833 2.57625 7.5321 6.15374 8.7548C9.60374 21.0631 9.77249 20.7863 9.77249 20.5441 9.77249 20.3249 9.76125 19.5982 9.76125 18.8254 7.5 19.2522 6.915 18.2602 6.735 17.7412 6.63375 17.4759 6.19499 16.6569 5.8125 16.4378 5.4975 16.2647 5.0475 15.838 5.80124 15.8264 6.51 15.8149 7.01625 16.4954 7.18499 16.7723 7.99499 18.1679 9.28875 17.7758 9.80625 17.5335 9.885 16.9337 10.1212 16.53 10.38 16.2993 8.3775 16.0687 6.285 15.2728 6.285 11.7432c0-1.0035.34875-1.834.92249-2.47994C7.1175 9.03257 6.8025 8.08674 7.2975 6.81794c0 0 .753749999999999-.24223 2.47499.94583.72001-.20762 1.48501-.31143 2.25001-.31143C12.7875 7.45234 13.5525 7.55615 14.2725 7.76377c1.7212-1.19959 2.475-.94583 2.475-.94583C17.2424 8.08674 16.9275 9.03257 16.8375 9.26326 17.4113 9.9092 17.76 10.7281 17.76 11.7432c0 3.5411-2.1037 4.3255-4.1063 4.5561C13.98 16.5877 14.2613 17.1414 14.2613 18.0065 14.2613 19.2407 14.25 20.2326 14.25 20.5441 14.25 20.7863 14.4188 21.0746 14.8688 20.9824 16.6554 20.364 18.2079 19.1866 19.3078 17.6162c1.0999-1.5705 1.6917-3.4551 1.6922-5.3886C21 7.12937 16.9725 3 12 3z"></path></svg>
        </a>
        <a href={site.linkedin}
           target="_blank" rel="noopener noreferrer"
           aria-label="LinkedIn">
          <svg class="w-5 h-5" height="1em" viewBox="0 0 448 512"><path fill="currentColor" d="M416 32H31.9C14.3 32 0 46.5.0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6.0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3.0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2.0 38.5 17.3 38.5 38.5.0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6.0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2.0 79.7 44.3 79.7 101.9V416z"></path></svg>
        </a>
      </nav>
      <div class="button-row">
        <a class="button button-primary" href="/blog/">Explore articles <span>↗</span></a>
        <a class="button button-secondary" href="/projects/">Explore projects</a>
        <a class="button button-secondary" href="/tools/">Developer tools</a>
      </div>
      <div class="hero-facts">
        <div><strong>{site.experience}</strong><span>Years in IT</span></div>
        <div><strong>Full stack</strong><span>Engineering</span></div>
        <div><strong>AI + Cloud</strong><span>Modern systems</span></div>
      </div>
    </div>
    <!--<div class="hero-visual" aria-label="Engineering principles">
      <div class="terminal-window">
        <div class="terminal-top"><div class="window-dots"><i></i><i></i><i></i></div><span>engineering-notes.ts</span><span class="terminal-status">● ready</span></div>
        <pre class="hero-code"><code><span class="code-purple">const</span> <span class="code-blue">principles</span> = &#123;
  <span class="code-green">design</span>: <span class="code-orange">'for change'</span>,
  <span class="code-green">build</span>: <span class="code-orange">'for scale'</span>,
  <span class="code-green">learn</span>: <span class="code-orange">'continuously'</span>,
  <span class="code-green">share</span>: <span class="code-orange">'what works'</span>
&#125;;

<span class="code-purple">export default</span> principles;</code></pre>
        <div class="terminal-bottom"><span>⌘&nbsp; practical engineering</span><span>UTF-8</span></div>
      </div>
      <div class="floating-chip chip-top"><span class="chip-icon">⌁</span> System design</div>
      <div class="floating-chip chip-bottom"><span class="chip-icon">✳</span> AI engineering</div>
    </div>-->
  </section>

  <section class="hero section container">

    <SectionTitle eyebrow="AREAS OF EXPLORATION" title="Engineering across the stack" description="Practical knowledge from designing, building, shipping, and operating software." />
    <div class="expertise-grid">
      {site.expertise.map((item, index) => (
        <a class="expertise-card" href={index === 1 ? '/blog/?category=AI' : index === 2 ? '/projects/' : '/expertise/'}>
          <span class="expertise-icon">{item.icon}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <span class="subtle-arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="hero section section-muted container">
      <SectionTitle eyebrow="RECENT WRITING" title="Latest engineering notes" description="Architecture decisions, implementation details, and lessons learned." href="/blog/" linkLabel="All articles" />
      {posts.length > 0 ? (
        <div class="article-grid">{posts.map(post => <ArticleCard post={post} />)}</div>
      ) : (
        <div class="empty-state"><span class="empty-icon">✎</span><h3>Your first article starts here</h3><p>Add a Markdown file under <code>src/content/blog/</code> to publish your first post.</p><a class="text-link" href="/blog/">Explore sample articles →</a></div>
      )}
  </section>

  <section class="hero section container">
    <div class="cta-panel">
      <div><p class="eyebrow">BUILT THROUGH EXPERIENCE</p><h2>Good engineering is more than code.</h2><p>Explore the systems, trade-offs, and tools behind practical software delivery.</p></div>
      <a class="button button-primary" href="/about/">About my journey <span>↗</span></a>
    </div>
  </section>
</SiteLayout>
<style>
  .center {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
    align-items: center;
  }
  .tagline {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
    font-size: clamp(22px, 3vw, 30px);
    margin-top: 8px;
    color: var(--heading);
  }

  .animated-words {
    display: inline-grid;
    color: var(--accent);
    font-weight: 500;
    text-align: center;
  }

  .animated-words span {
    grid-area: 1 / 1;
    opacity: 0;
    animation: rotate-words 12s infinite;
  }

  .animated-words span:nth-child(2) {
    animation-delay: 3s;
  }

  .animated-words span:nth-child(3) {
    animation-delay: 6s;
  }

  .animated-words span:nth-child(4) {
    animation-delay: 9s;
  }

  @keyframes rotate-words {
    0%, 3% { opacity: 0; transform: translateY(10px); }
    7%, 21% { opacity: 1; transform: translateY(0); }
    25%, 100% { opacity: 0; transform: translateY(-10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .animated-words span,
    .scroll-indicator span {
      animation: none;
    }

    .animated-words span:first-child {
      opacity: 1;
    }
  }

  .social-links {
    display: flex;
    gap: 16px;
    margin-bottom: 38px;
  }

  .social-links a {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #ededed;
    border: 1px solid #d4d4d4;
    color: #20242b;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .social-links a:hover {
    background: #1261c9;
    border-color: #1261c9;
    color: white;
    transform: translateY(-3px);
  }
</style>