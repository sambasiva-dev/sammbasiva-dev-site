---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
const { title = site.brand, description = site.intro, currentPath = Astro.url.pathname } = Astro.props;
import { ClientRouter } from 'astro:transitions';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1120" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
   <!-- <ClientRouter />-->
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main><slot /></main>
    <Footer />
    <script>
      import mermaid from 'mermaid';
      mermaid.initialize({
          startOnLoad: false,
          theme: document.documentElement.dataset.theme === 'light' ? 'default' : 'dark',
          securityLevel: 'strict',
          flowchart: {
              useMaxWidth: true,
              htmlLabels: true,
              curve: 'basis',
              },
          });
      // Expressive Code renders ```mermaid fences as <pre data-language="mermaid">
      // with one <div class="ec-line"> per source line (no newlines in textContent),
      // so read the lines back individually. Plain <pre><code class="language-mermaid">
      // is still supported as a fallback.
      function mermaidSource(pre) {
          const lines = pre.querySelectorAll('.ec-line');
          if (lines.length) return [...lines].map(line => line.textContent || '').join('\n');
          const code = pre.querySelector('code');
          return (code ?? pre).textContent || '';
      }

      let mermaidCounter = 0;

      async function renderMermaid() {
          const blocks = document.querySelectorAll(
              'pre[data-language="mermaid"], pre code.language-mermaid, pre code.lang-mermaid'
              );

          for (const block of blocks) {
              const pre = block.tagName === 'PRE' ? block : block.closest('pre');

              if (!pre || pre.dataset.mermaidRendered === 'true') continue;

              pre.dataset.mermaidRendered = 'true';

              const source = mermaidSource(pre);
              const container = document.createElement('div');
              container.className = 'mermaid-diagram';

              try {
                  const { svg } = await mermaid.render(
                      `mermaid-diagram-${++mermaidCounter}`,
                      source
                      );

                  container.innerHTML = svg;
                  pre.replaceWith(container);
              } catch (error) {
                  console.error('Mermaid rendering failed:', error);
                  pre.dataset.mermaidRendered = 'false';
              }
          }
      }

      document.addEventListener('astro:page-load', renderMermaid);
      document.addEventListener('DOMContentLoaded', renderMermaid);

      renderMermaid();
    </script>
  </body>
</html>