---
import SiteLayout from '../layouts/SiteLayout.astro';
const { selectedTool = 'json-formatter' } = Astro.props;
const tools = [
  { id: 'json-format', slug: 'json-formatter', label: 'JSON Formatter', icon: '{ }' },
  { id: 'base64', slug: 'base64', label: 'Base64 Encode / Decode', icon: '64' },
  { id: 'json-compare', slug: 'json-compare', label: 'JSON Compare', icon: '≠' },
  { id: 'xml-format', slug: 'xml-formatter', label: 'XML Formatter', icon: '</>' },
  { id: 'xml-compare', slug: 'xml-compare', label: 'XML Compare', icon: '⇄' },
  { id: 'url-codec', slug: 'url-encode', label: 'URL Encode / Decode', icon: '%2F' },
  { id: 'jwt-inspector', slug: 'jwt-inspector', label: 'JWT Payload Inspector', icon: 'JWT' },
  { id: 'uuid-generator', slug: 'uuid-generator', label: 'UUID Generator', icon: 'ID' },
  { id: 'timestamp-converter', slug: 'timestamp-converter', label: 'Timestamp Converter', icon: '⏱' },
  { id: 'hash-generator', slug: 'hash-generator', label: 'Hash Generator', icon: '#' }
];
const selected = tools.find((tool) => tool.slug === selectedTool) ?? tools[0];
---
<SiteLayout title={`${selected.label} | Developer Tools`} currentPath="/tools/">
  <section class="page-hero container tools-hero">
    <p class="eyebrow"><span class="status-dot"></span> BROWSER-BASED UTILITIES</p>
    <h1>Developer <span class="gradient-text">toolkit.</span></h1>
    <p class="hero-description">Choose a utility from the list. Processing runs locally in your browser; input is not uploaded to a server.</p>
  </section>
  <section class="section container tools-workspace">
    <aside class="tools-sidebar" aria-label="Developer tools">
      <p class="tools-sidebar-title">ALL TOOLS</p>
      {tools.map((tool) => <a class:list={['tools-sidebar-link', { active: selected.slug === tool.slug }]} href={`/tools/${tool.slug}/`} aria-current={selected.slug === tool.slug ? 'page' : undefined}>
        <span class="tools-sidebar-icon">{tool.icon}</span><span>{tool.label}</span>
      </a>)}
    </aside>
    <div class="tools-main" aria-live="polite">
      <div class="tools-selected-heading"><span class="eyebrow">SELECTED UTILITY</span><h2>{selected.label}</h2></div>
      <div class="tools-grid" id="tools-grid">
    <article class="tool-card" data-tool="json format beautify minify validate" id="json-format" hidden={selectedTool != "json-formatter"}><div class="tool-card-head"><span class="tool-icon">{ }</span><div><h2>JSON formatter</h2><p>Beautify, minify, and validate JSON.</p></div></div><label for="json-file">Open a JSON file (processed only when you click a tool action)</label><input id="json-file" type="file" accept=".json,application/json,text/json" /><label for="json-input">Input JSON</label><textarea id="json-input" spellcheck="false" placeholder='{"name":"Ada","active":true}'></textarea><div class="tool-actions"><button class="button button-primary" id="json-beautify">Beautify</button><button class="button button-secondary" id="json-minify">Minify</button><button class="button button-secondary" id="json-clear">Clear</button></div><p class="tool-status" id="json-status" aria-live="polite"></p><label for="json-output">Formatted output</label><textarea id="json-output" spellcheck="false" readonly placeholder="Formatted JSON appears here"></textarea><div class="tool-actions"><button class="button button-secondary" id="json-tree-toggle">Show expandable tree</button><button class="text-link tool-copy" data-copy="json-output">Copy output ↗</button></div><div id="json-tree" class="json-tree" hidden></div></article>
    <article class="tool-card" data-tool="base64 encode decode text" id="base64" hidden={selectedTool != "base64"}><div class="tool-card-head"><span class="tool-icon">64</span><div><h2>Base64 encode / decode</h2><p>Convert text to Base64 and back.</p></div></div><label for="base64-input">Input</label><textarea id="base64-input" spellcheck="false" placeholder="Enter text or Base64 value"></textarea><div class="tool-actions"><button class="button button-primary" id="base64-encode">Encode</button><button class="button button-secondary" id="base64-decode">Decode</button><button class="button button-secondary" id="base64-clear">Clear</button></div><p class="tool-status" id="base64-status" aria-live="polite"></p><label for="base64-output">Output</label><textarea id="base64-output" spellcheck="false" readonly placeholder="Result appears here"></textarea><button class="text-link tool-copy" data-copy="base64-output">Copy output ↗</button></article>
    <article class="tool-card" data-tool="json compare diff compare" id="json-compare" hidden={selectedTool != "json-compare"}><div class="tool-card-head"><span class="tool-icon">≠</span><div><h2>JSON compare</h2><p>Compare two JSON documents structurally.</p></div></div><label for="json-left">JSON A</label><textarea id="json-left" spellcheck="false" placeholder='{"version":1}'></textarea><label for="json-right">JSON B</label><textarea id="json-right" spellcheck="false" placeholder='{"version":2}'></textarea><div class="tool-actions"><button class="button button-primary" id="json-compare-run">Compare JSON</button><button class="button button-secondary" id="json-compare-clear">Clear</button></div><div class="tool-result diff-result" id="json-compare-result" aria-live="polite">Compare result will appear here.</div><button class="text-link" id="json-compare-copy">Copy comparison ↗</button></article>
    <article class="tool-card" data-tool="xml format beautify pretty print" id="xml-format" hidden={selectedTool != "xml-formatter"}><div class="tool-card-head"><span class="tool-icon">&lt;/&gt;</span><div><h2>XML formatter</h2><p>Indent XML and check basic well-formedness.</p></div></div><label for="xml-input">Input XML</label><textarea id="xml-input" spellcheck="false" placeholder="&lt;root&gt;&lt;item&gt;value&lt;/item&gt;&lt;/root&gt;"></textarea><div class="tool-actions"><button class="button button-primary" id="xml-format-run">Format XML</button><button class="button button-secondary" id="xml-minify">Minify</button><button class="button button-secondary" id="xml-clear">Clear</button></div><p class="tool-status" id="xml-status" aria-live="polite"></p><label for="xml-output">Output</label><textarea id="xml-output" spellcheck="false" readonly placeholder="Formatted XML appears here"></textarea><button class="text-link tool-copy" data-copy="xml-output">Copy output ↗</button></article>
    <article class="tool-card" data-tool="xml compare diff" id="xml-compare" hidden={selectedTool != "xml-compare"}><div class="tool-card-head"><span class="tool-icon">⇄</span><div><h2>XML compare</h2><p>Normalize indentation and compare XML text.</p></div></div><label for="xml-left">XML A</label><textarea id="xml-left" spellcheck="false" placeholder="&lt;root&gt;A&lt;/root&gt;"></textarea><label for="xml-right">XML B</label><textarea id="xml-right" spellcheck="false" placeholder="&lt;root&gt;B&lt;/root&gt;"></textarea><div class="tool-actions"><button class="button button-primary" id="xml-compare-run">Compare XML</button><button class="button button-secondary" id="xml-compare-clear">Clear</button></div><div class="tool-result diff-result" id="xml-compare-result" aria-live="polite">Comparison result will appear here.</div><button class="text-link" id="xml-compare-copy">Copy comparison ↗</button></article>
    <article class="tool-card" data-tool="url encode decode uri component" id="url-codec" hidden={selectedTool != "url-encode"}><div class="tool-card-head"><span class="tool-icon">%2F</span><div><h2>URL encode / decode</h2><p>Encode or decode URL components.</p></div></div><label for="url-input">Input</label><textarea id="url-input" spellcheck="false" placeholder="Text or URL component"></textarea><div class="tool-actions"><button class="button button-primary" id="url-encode">Encode</button><button class="button button-secondary" id="url-decode">Decode</button><button class="button button-secondary" id="url-clear">Clear</button></div><label for="url-output">Output</label><textarea id="url-output" readonly></textarea><button class="text-link tool-copy" data-copy="url-output">Copy output ↗</button></article>
    <article class="tool-card" data-tool="jwt token payload inspect decode" id="jwt-inspector" hidden={selectedTool != "jwt-inspector"}><div class="tool-card-head"><span class="tool-icon">JWT</span><div><h2>JWT payload inspector</h2><p>Decode header and payload locally; this does not verify the signature.</p></div></div><label for="jwt-input">JWT token</label><textarea id="jwt-input" spellcheck="false" placeholder="eyJhbGciOi..."></textarea><div class="tool-actions"><button class="button button-primary" id="jwt-decode">Inspect token</button><button class="button button-secondary" id="jwt-clear">Clear</button></div><p class="tool-status" id="jwt-status" aria-live="polite"></p><label for="jwt-output">Decoded header and payload</label><textarea id="jwt-output" readonly></textarea><button class="text-link tool-copy" data-copy="jwt-output">Copy output ↗</button></article>
    <article class="tool-card" data-tool="uuid unique identifier generate random" id="uuid-generator" hidden={selectedTool != "uuid-generator"}><div class="tool-card-head"><span class="tool-icon">ID</span><div><h2>UUID generator</h2><p>Generate one or more random UUID v4 identifiers.</p></div></div><label for="uuid-count">How many? (1–1000)</label><input id="uuid-count" type="number" min="1" max="1000" value="1" /><div class="tool-actions"><button class="button button-primary" id="uuid-generate">Generate UUIDs</button></div><label for="uuid-output">Output</label><textarea id="uuid-output" readonly></textarea><button class="text-link tool-copy" data-copy="uuid-output">Copy output ↗</button></article>
    <article class="tool-card" data-tool="timestamp date epoch unix converter" id="timestamp-converter" hidden={selectedTool != "timestamp-converter"}><div class="tool-card-head"><span class="tool-icon">⏱</span><div><h2>Timestamp converter</h2><p>Convert Unix seconds/milliseconds to a readable date and back.</p></div></div><label for="timestamp-input">Timestamp or ISO date</label><input id="timestamp-input" placeholder="e.g. 1735689600 or 2025-01-01T00:00:00Z" /><div class="tool-actions"><button class="button button-primary" id="timestamp-convert">Convert</button><button class="button button-secondary" id="timestamp-now">Use current time</button></div><label for="timestamp-output">Conversion</label><textarea id="timestamp-output" readonly></textarea><button class="text-link tool-copy" data-copy="timestamp-output">Copy output ↗</button></article>
    <article class="tool-card" data-tool="hash sha256 sha-256 sha384 sha512 digest generator" id="hash-generator" hidden={selectedTool != "hash-generator"}><div class="tool-card-head"><span class="tool-icon">#</span><div><h2>Hash generator</h2><p>Generate SHA-256, SHA-384, or SHA-512 digest using Web Crypto.</p></div></div><label for="hash-input">Text to hash</label><textarea id="hash-input" spellcheck="false"></textarea><label for="hash-algorithm">Algorithm</label><select id="hash-algorithm"><option>SHA-256</option><option>SHA-384</option><option>SHA-512</option></select><div class="tool-actions"><button class="button button-primary" id="hash-generate">Generate hash</button></div><label for="hash-output">Hex digest</label><textarea id="hash-output" readonly></textarea><button class="text-link tool-copy" data-copy="hash-output">Copy output ↗</button></article>
  </section>
  <script>
    const byId = (id) => document.getElementById(id);
    const setStatus = (id, message, bad = false) => { const el = byId(id); if (el) { el.textContent = message; el.classList.toggle('is-error', bad); } };
    const clearIds = (...ids) => ids.forEach(id => { const el = byId(id); if (el) el.value = ''; });
    const formatJson = async (minify=false) => { const input=byId('json-input').value; if(input.length > 1_000_000 && typeof Worker !== 'undefined' && typeof Blob !== 'undefined'){ setStatus('json-status','Processing large JSON in a background worker…'); const source=`self.onmessage=e=>{try{const parsed=JSON.parse(e.data.input);self.postMessage({ok:true,value:JSON.stringify(parsed,null,e.data.minify?0:2)})}catch(err){self.postMessage({ok:false,error:err.message})}}`; const url=URL.createObjectURL(new Blob([source],{type:'text/javascript'})); const worker=new Worker(url); worker.onmessage=e=>{worker.terminate();URL.revokeObjectURL(url);if(e.data.ok){byId('json-output').value=e.data.value;setStatus('json-status','Valid JSON · formatted successfully');}else setStatus('json-status',`Invalid JSON: ${e.data.error}`,true);};worker.onerror=()=>{worker.terminate();URL.revokeObjectURL(url);setStatus('json-status','Background processing failed. Try a smaller file.',true);};worker.postMessage({input,minify});return;} try { byId('json-output').value=JSON.stringify(JSON.parse(input),null,minify?0:2);setStatus('json-status',minify?'Valid JSON · minified successfully':'Valid JSON · formatted successfully');}catch(e){setStatus('json-status',`Invalid JSON: ${e.message}`,true);} };
    byId('json-beautify')?.addEventListener('click', () => formatJson(false));
    byId('json-minify')?.addEventListener('click', () => formatJson(true));
    byId('json-clear')?.addEventListener('click', () => { clearIds('json-input','json-output'); setStatus('json-status',''); });
    byId('base64-encode')?.addEventListener('click', () => { try { byId('base64-output').value = btoa(unescape(encodeURIComponent(byId('base64-input').value))); setStatus('base64-status','Encoded successfully'); } catch (e) { setStatus('base64-status', e.message, true); } });
    byId('base64-decode')?.addEventListener('click', () => { try { byId('base64-output').value = decodeURIComponent(escape(atob(byId('base64-input').value.trim()))); setStatus('base64-status','Decoded successfully'); } catch (e) { setStatus('base64-status','Invalid Base64 or unsupported text encoding',true); } });
    byId('base64-clear')?.addEventListener('click', () => { clearIds('base64-input','base64-output'); setStatus('base64-status',''); });
    const stable = value => { if (Array.isArray(value)) return value.map(stable); if (value && typeof value === 'object') return Object.fromEntries(Object.keys(value).sort().map(k => [k, stable(value[k])])); return value; };
    byId('json-compare-run')?.addEventListener('click', () => { try { const a=stable(JSON.parse(byId('json-left').value)), b=stable(JSON.parse(byId('json-right').value)); const out = JSON.stringify(a) === JSON.stringify(b) ? '✓ JSON documents are structurally equivalent.' : `JSON documents differ.\n\nA (normalized):\n${JSON.stringify(a,null,2)}\n\nB (normalized):\n${JSON.stringify(b,null,2)}`; byId('json-compare-result').textContent=out; byId('json-compare-result').classList.remove('is-error'); } catch(e) { byId('json-compare-result').textContent=`Could not compare: ${e.message}`; byId('json-compare-result').classList.add('is-error'); } });
    byId('json-compare-clear')?.addEventListener('click', () => { clearIds('json-left','json-right'); byId('json-compare-result').textContent='Comparison result will appear here.'; });
    const xmlDocument = text => { const doc = new DOMParser().parseFromString(text, 'application/xml'); const err = doc.querySelector('parsererror'); if (err) throw new Error(err.textContent || 'Invalid XML'); return doc; };
    const prettyXml = text => { const doc=xmlDocument(text); const raw=new XMLSerializer().serializeToString(doc); let formatted='', indent=0; const tokens=raw.replace(/>\s*</g,'><').replace(/></g,'>\n<').split('\n'); for (const token of tokens) { if (/^<\//.test(token)) indent=Math.max(0,indent-1); formatted += '  '.repeat(indent)+token+'\n'; if (/^<[^!?/][^>]*[^/]?>$/.test(token) && !token.includes('</')) indent++; } return formatted.trim(); };
    byId('xml-format-run')?.addEventListener('click', () => { try { byId('xml-output').value=prettyXml(byId('xml-input').value); setStatus('xml-status','XML parsed and formatted'); } catch(e) { setStatus('xml-status',`Invalid XML: ${e.message}`,true); } });
    byId('xml-minify')?.addEventListener('click', () => { try { byId('xml-output').value=new XMLSerializer().serializeToString(xmlDocument(byId('xml-input').value)).replace(/>\s+</g,'><').trim(); setStatus('xml-status','XML minified'); } catch(e) { setStatus('xml-status',`Invalid XML: ${e.message}`,true); } });
    byId('xml-clear')?.addEventListener('click', () => { clearIds('xml-input','xml-output'); setStatus('xml-status',''); });
    byId('xml-compare-run')?.addEventListener('click', () => { try { const a=new XMLSerializer().serializeToString(xmlDocument(byId('xml-left').value)).replace(/>\s+</g,'><').trim(); const b=new XMLSerializer().serializeToString(xmlDocument(byId('xml-right').value)).replace(/>\s+</g,'><').trim(); byId('xml-compare-result').textContent=a===b?'✓ XML documents are equivalent after whitespace normalization.':`XML documents differ.\n\nA:\n${a}\n\nB:\n${b}`; byId('xml-compare-result').classList.remove('is-error'); } catch(e) { byId('xml-compare-result').textContent=`Could not compare: ${e.message}`; byId('xml-compare-result').classList.add('is-error'); } });
    byId('xml-compare-clear')?.addEventListener('click', () => { clearIds('xml-left','xml-right'); byId('xml-compare-result').textContent='Comparison result will appear here.'; });
    // Files are read only on explicit selection; large files are not auto-parsed while typing.
    byId('json-file')?.addEventListener('change', async event => { const file=event.target.files?.[0]; if (!file) return; if (file.size > 20*1024*1024 && !confirm('This file is larger than 20 MB. Parsing it may use substantial memory. Continue?')) { event.target.value=''; return; } byId('json-input').value=await file.text(); setStatus('json-status',`Loaded ${file.name} (${(file.size/1024/1024).toFixed(2)} MB). Click Beautify to process.`); });
    const escapeHtml = value => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const buildTree = (value, key='root') => { const wrap=document.createElement('div'); wrap.className='json-tree-node'; const isBranch=value!==null && typeof value==='object'; if(isBranch){ const details=document.createElement('details'); details.open=true; const summary=document.createElement('summary'); summary.textContent=`${key}: ${Array.isArray(value)?'Array':'Object'} (${Object.keys(value).length})`; details.append(summary); for(const [k,v] of Object.entries(value)){ details.append(buildTree(v,Array.isArray(value)?`[${k}]`:k)); } wrap.append(details); } else { const line=document.createElement('div'); line.className='json-tree-leaf'; line.textContent=`${key}: ${JSON.stringify(value)}`; wrap.append(line); } return wrap; };
    byId('json-tree-toggle')?.addEventListener('click',()=>{const tree=byId('json-tree'); if(tree.hidden){try{tree.replaceChildren(buildTree(JSON.parse(byId('json-output').value)));tree.hidden=false;byId('json-tree-toggle').textContent='Hide expandable tree';}catch{setStatus('json-status','Format JSON first to view the tree.',true);}}else{tree.hidden=true;byId('json-tree-toggle').textContent='Show expandable tree';}});
    const compareValues = (a,b,path='') => { let rows=[]; const keys=new Set([...Object.keys(a&&typeof a==='object'?a:{}),...Object.keys(b&&typeof b==='object'?b:{})]); if(a===null||b===null||typeof a!=='object'||typeof b!=='object'||Array.isArray(a)!==Array.isArray(b)){ if(JSON.stringify(a)!==JSON.stringify(b)) rows.push({kind:'changed',path:path||'root',a,b}); return rows; } for(const key of keys){const hasA=Object.prototype.hasOwnProperty.call(a,key),hasB=Object.prototype.hasOwnProperty.call(b,key),p=path?`${path}.${key}`:key;if(hasA&&!hasB)rows.push({kind:'removed',path:p,a:a[key]});else if(!hasA&&hasB)rows.push({kind:'added',path:p,b:b[key]});else rows=rows.concat(compareValues(a[key],b[key],p));} return rows; };
    const renderDiffRows = rows => rows.length ? rows.map(r=>`<div class="diff-line diff-${r.kind}"><strong>${escapeHtml(r.path)}</strong><span>${r.kind==='changed'?`A: ${escapeHtml(JSON.stringify(r.a))} → B: ${escapeHtml(JSON.stringify(r.b))}`:r.kind==='removed'?`A only: ${escapeHtml(JSON.stringify(r.a))}`:`B only: ${escapeHtml(JSON.stringify(r.b))}`}</span></div>`).join('') : '<div class="diff-line">✓ No differences found.</div>';
    byId('json-compare-run')?.addEventListener('click', () => { try { const a=JSON.parse(byId('json-left').value), b=JSON.parse(byId('json-right').value); const rows=compareValues(a,b); byId('json-compare-result').innerHTML=renderDiffRows(rows); byId('json-compare-result').classList.remove('is-error'); } catch(e) { byId('json-compare-result').textContent=`Could not compare: ${e.message}`; byId('json-compare-result').classList.add('is-error'); } });
    byId('json-compare-copy')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(byId('json-compare-result').innerText);byId('json-compare-copy').textContent='Copied ✓';}catch{byId('json-compare-copy').textContent='Clipboard unavailable';}});
    byId('xml-compare-run')?.addEventListener('click',()=>{try{const a=xmlDocument(byId('xml-left').value),b=xmlDocument(byId('xml-right').value);const flatten=(node,path='')=>{let out={};if(node.nodeType===Node.ELEMENT_NODE){const key=path?`${path}/${node.nodeName}`:node.nodeName;const attrs=Array.from(node.attributes||[]);for(const attr of attrs)out[`${key}/@${attr.name}`]=attr.value;const text=Array.from(node.childNodes).filter(n=>n.nodeType===Node.TEXT_NODE).map(n=>n.nodeValue.trim()).filter(Boolean).join(' ');if(text)out[`${key}/#text`]=text;Array.from(node.children||[]).forEach(child=>Object.assign(out,flatten(child,key)));}return out;};const rows=compareValues(flatten(a.documentElement),flatten(b.documentElement));byId('xml-compare-result').innerHTML=renderDiffRows(rows);byId('xml-compare-result').classList.remove('is-error');}catch(e){byId('xml-compare-result').textContent=`Could not compare: ${e.message}`;byId('xml-compare-result').classList.add('is-error');}});
    byId('xml-compare-copy')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(byId('xml-compare-result').innerText);byId('xml-compare-copy').textContent='Copied ✓';}catch{byId('xml-compare-copy').textContent='Clipboard unavailable';}});
    byId('url-encode')?.addEventListener('click',()=>byId('url-output').value=encodeURIComponent(byId('url-input').value)); byId('url-decode')?.addEventListener('click',()=>{try{byId('url-output').value=decodeURIComponent(byId('url-input').value);}catch{byId('url-output').value='Invalid URL-encoded input';}}); byId('url-clear')?.addEventListener('click',()=>clearIds('url-input','url-output'));
    byId('jwt-decode')?.addEventListener('click',()=>{try{const parts=byId('jwt-input').value.trim().split('.');if(parts.length<2)throw new Error('Expected a JWT with header.payload.signature');const decode=p=>JSON.parse(decodeURIComponent(escape(atob(p.replace(/-/g,'+').replace(/_/g,'/').padEnd(Math.ceil(p.length/4)*4,'=')))));byId('jwt-output').value=JSON.stringify({header:decode(parts[0]),payload:decode(parts[1])},null,2);setStatus('jwt-status','Decoded locally. Signature not verified.',false);}catch(e){setStatus('jwt-status',`Unable to decode token: ${e.message}`,true);}}); byId('jwt-clear')?.addEventListener('click',()=>{clearIds('jwt-input','jwt-output');setStatus('jwt-status','');});
    byId('uuid-generate')?.addEventListener('click',()=>{const count=Math.max(1,Math.min(1000,Number(byId('uuid-count').value)||1));byId('uuid-output').value=Array.from({length:count},()=>crypto.randomUUID()).join('\n');});
    const convertTimestamp=()=>{const raw=byId('timestamp-input').value.trim();if(!raw)return;let date;if(/^\d+(\.\d+)?$/.test(raw)){const n=Number(raw);date=new Date(Math.abs(n)<1e11?n*1000:n);}else date=new Date(raw);if(Number.isNaN(date.getTime())){byId('timestamp-output').value='Invalid timestamp or date';return;}byId('timestamp-output').value=`ISO: ${date.toISOString()}\nLocal: ${date.toString()}\nUnix seconds: ${Math.floor(date.getTime()/1000)}\nUnix milliseconds: ${date.getTime()}`;}; byId('timestamp-convert')?.addEventListener('click',convertTimestamp);byId('timestamp-now')?.addEventListener('click',()=>{byId('timestamp-input').value=String(Date.now());convertTimestamp();});
    byId('hash-generate')?.addEventListener('click',async()=>{try{const bytes=new TextEncoder().encode(byId('hash-input').value);const digest=await crypto.subtle.digest(byId('hash-algorithm').value,bytes);byId('hash-output').value=Array.from(new Uint8Array(digest),b=>b.toString(16).padStart(2,'0')).join('');}catch(e){byId('hash-output').value=`Hash generation failed: ${e.message}`;}});
    document.querySelectorAll('[data-copy]').forEach(button => button.addEventListener('click', async () => { const value=byId(button.dataset.copy)?.value || ''; try { await navigator.clipboard.writeText(value); button.textContent='Copied ✓'; setTimeout(() => button.textContent='Copy output ↗', 1400); } catch { button.textContent='Clipboard unavailable'; } }));
  </script>
      </div>
    </div>
  </section>
</SiteLayout>
