---
const { eyebrow, title, description, href, linkLabel = 'View all posts' } = Astro.props;
---
<div class="section-title">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {description && <p class="section-description">{description}</p>}
  </div>
  {href && <a class="text-link" href={href}>{linkLabel} <span aria-hidden="true">↗</span></a>}
</div>