---
const { post } = Astro.props;
const date = post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<article class="article-card">
  <div class="card-meta"><span class="category">{post.data.category}</span><span>{date}</span></div>
  <h3><a href={`/blog/${post.id.replace(/\.(md|mdx)$/, '')}/`}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <div class="tag-list">{post.data.tags.slice(0, 3).map(tag => <span class="tag">{tag}</span>)}</div>
  <a class="card-link" href={`/blog/${post.id.replace(/\.(md|mdx)$/, '')}/`}>Read article <span aria-hidden="true">→</span></a>
</article>