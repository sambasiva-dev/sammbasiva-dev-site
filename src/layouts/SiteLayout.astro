---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
const { title = site.brand, description = site.intro, currentPath = Astro.url.pathname } = Astro.props;
import { ClientRouter } from 'astro:transitions';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1120" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
   <!-- <ClientRouter />-->
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main><slot /></main>
    <Footer />
    <script>
      import mermaid from 'mermaid';
      const enhanceMermaid = async () => {
        const blocks = [...document.querySelectorAll<HTMLElement>('pre code.language-mermaid')];
        blocks.forEach(code => {
          const pre = code.closest('pre');
          if (!pre || pre.dataset.mermaidEnhanced) return;
          pre.dataset.mermaidEnhanced = 'true';
          const diagram = document.createElement('pre');
          diagram.className = 'mermaid';
          diagram.textContent = code.textContent ?? '';
          pre.replaceWith(diagram);
        });
        const diagrams = [...document.querySelectorAll<HTMLElement>('pre.mermaid:not([data-processed])')];
        if (!diagrams.length) return;
        mermaid.initialize({ startOnLoad: false, theme: document.documentElement.dataset.theme === 'light' ? 'default' : 'dark', securityLevel: 'strict' });
        try { await mermaid.run({ nodes: diagrams }); }
        catch (error) { console.error('Mermaid diagram rendering failed', error); }
      };
      enhanceMermaid();
    </script>
  </body>
</html>